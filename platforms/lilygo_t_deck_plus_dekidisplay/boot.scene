        {
          "active": true,
          "children": [],
          "components": [
            {
              "properties": {
                "asyncPresent": true,
                "blInvert": false,
                "blPin": 42,
                "controller": "ST7789",
                "csPin": 12,
                "dcPin": 11,
                "doubleBuffer": false,
                "initSequence": "# LilyGO T-Deck ST7789: LilyGO's TFT_eSPI setup for the board (Setup210_LilyGo_T_Deck,\n# INIT_SEQUENCE_2), with VCOM 0x19, tuned live on a T-Deck Plus. The controller's\n# default (VCOM 0x28, a lower gate voltage) leaves this panel with a fading ghost.\n11; delay 120          # SLPOUT first\n13                     # NORON\nB2 0C 0C 00 33 33      # PORCTRL\nB7 75                  # GCTRL: VGH 14.97 V, VGL -10.43 V\nBB 19                  # VCOMS 0.725 V\nC0 2C                  # LCMCTRL: swaps red and blue, so rgbOrder on\nC2 01                  # VDVVRHEN\nC3 13                  # VRHS\nC4 20                  # VDVSET\nC6 0F                  # FRCTR2: 60 Hz\nD0 A4 A1               # PWCTRL1\nE0 D0 0D 14 0D 0D 09 38 44 4E 3A 17 18 2F 30   # PVGAMCTRL\nE1 D0 09 0F 08 07 14 37 44 4D 38 15 16 2C 3E   # NVGAMCTRL\n29; delay 120          # DISPON\n",
                "invertColor": true,
                "memoryHeight": 320,
                "memoryWidth": 240,
                "offsetX": 0,
                "offsetY": 0,
                "panelHeight": 320,
                "panelWidth": 240,
                "rgbOrder": true,
                "rotation": "Landscape",
                "rstPin": -1,
                "spiHost": 1,
                "spiWriteHz": 80000000,
                "usePsram": false
              },
              "type": "DekiDisplay::DisplayPanelComponent"
            }
          ],
          "id": 603,
          "name": "Display (ST7789)",
