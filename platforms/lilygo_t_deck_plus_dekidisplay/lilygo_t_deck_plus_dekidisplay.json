{
  "id": "lilygo_t_deck_plus_dekidisplay",
  "displayName": "LilyGO T-Deck Plus (deki-display)",
  "family": "espressif",
  "framework": "espidf",
  "frameworkOptions": {
    "idfTarget": "esp32s3",
    "mcuChip": "esp32s3",
    "cpuFreqHz": 240000000,
    "flashSize": 16777216,
    "psramMode": "oct",
    "sdkconfig": [
      "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y"
    ]
  },
  "externalMemorySize": 8388608,
  "screenWidth": 320,
  "screenHeight": 240,
  "colorFormat": "RGB565",
  "provides": [
    "filesystem",
    "threads",
    "psram",
    "spi",
    "i2c",
    "wifi",
    "bluetooth",
    "external-storage"
  ],
  "requiresPackages": [
    "deki-esp32-integration",
    "deki-lovyangfx-integration"
  ],
  "defines": [
    "ESP32"
  ],
  "bootScene": "platforms/lilygo_t_deck_plus_dekidisplay/boot.scene"
}
