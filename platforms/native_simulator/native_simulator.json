{
  "bootScene": "platforms/native_simulator/boot.scene",
  "colorFormat": "RGB565",
  "cxxFlags": [
    "-std=c++17",
    "-O0",
    "-g"
  ],
  "defines": [
    "SIMULATOR",
    "DEBUG",
    "DEKI_LOG_ENABLED"
  ],
  "displayName": "Desktop Simulator (SDL3)",
  "family": "native",
  "framework": "native",
  "frameworkOptions": {
    "displayBus": "SOFTWARE",
    "displayDriver": "SDL3"
  },
  "id": "native_simulator",
  "provides": [
    "desktop-os",
    "posix-process",
    "filesystem",
    "threads",
    "sdl3"
  ],
  "screenHeight": 720,
  "screenWidth": 1280
}
